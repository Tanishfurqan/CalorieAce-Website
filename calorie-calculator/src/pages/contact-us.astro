---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us - Calorie Calculator"
  description="Get in touch with the CalorieAce team with questions, feedback, or suggestions about our calorie, weight loss, and weight gain calculators."
>
  <main class="max-w-2xl mx-auto px-4 py-10">
    <h1 class="font-heading text-3xl md:text-4xl font-bold text-charcoal">Contact Us</h1>
    <p class="mt-4 font-body text-charcoal/80 leading-relaxed">
      Have a question, spotted an issue with the calculator, or have feedback on how we can improve? We'd love to hear from you.
    </p>

    <div class="mt-8 p-6 bg-white rounded-2xl border border-forest-light">
      <h2 class="font-heading text-lg font-semibold text-forest">Email Us</h2>
      <p class="mt-2 font-body text-charcoal/70">
        For general inquiries, feedback, or corrections, reach out at:
      </p>
      <a href="mailto:zenforgeaii@gmail.com" class="mt-2 inline-block font-body font-semibold text-forest underline">
        zenforgeaii@gmail.com
      </a>
    </div>

    <div class="mt-6 font-body text-sm text-gray-soft">
      <p>We aim to respond to all messages within 2–3 business days.</p>
    </div>
  </main>
</Layout>