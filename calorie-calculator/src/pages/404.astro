---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found - CalorieAce"
  description="The page you're looking for doesn't exist. Head back to the calorie calculator homepage."
>
  <main class="max-w-2xl mx-auto px-4 py-24 text-center">
    <p class="font-heading text-6xl font-bold text-forest">404</p>
    <h1 class="mt-4 font-heading text-2xl md:text-3xl font-bold text-charcoal">
      We couldn't find that page
    </h1>
    <p class="mt-3 font-body text-gray-soft max-w-md mx-auto">
      The page you're looking for may have been moved or no longer exists. Let's get you back on track.
    </p>

    <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/" class="bg-forest text-cream font-body font-semibold py-3 px-6 rounded-full hover:bg-forest-dark transition-colors">
        Go to Calorie Calculator
      </a>
      <a href="/weight-loss-calculator" class="bg-forest-light text-forest-dark font-body font-semibold py-3 px-6 rounded-full hover:bg-forest hover:text-cream transition-colors">
        Weight Loss Calculator
      </a>
    </div>
  </main>
</Layout>