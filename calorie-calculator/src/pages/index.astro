---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Calorie Calculator - Daily Calorie, TDEE & BMI Calculator | CalorieAce"
  description="Free calorie calculator to find your daily calorie needs, TDEE, and BMI for weight loss or weight gain. Supports kg, lbs, cm, and inches — accurate and easy to use."
>
  <main class="max-w-2xl mx-auto px-4 pt-2 pb-4 md:pt-10 md:pb-10">

   <!-- SECTION 1: Hero -->
    <div class="text-center pt-1 pb-3 md:pt-8 md:pb-8">
      <p class="font-body text-xs font-semibold tracking-widest text-forest uppercase">
        Metric &amp; Imperial
      </p>

      <h1 class="mt-3 font-heading text-4xl md:text-6xl font-bold text-charcoal leading-tight">
        Know exactly how many <span class="text-forest">calories</span> your body needs
      </h1>

      <p class="mt-4 font-body text-lg text-gray-soft max-w-xl mx-auto">
        Enter your details once and get maintenance calories, macros, and separate weight loss and weight gain plans matched to your activity level.
      </p>
    </div>

    <img
      src="/calorie-hero.webp"
      alt="Illustration representing calorie counting and daily nutrition tracking"
      class="w-full max-w-2xl mx-auto rounded-2xl mb-8"
      width="1200"
      height="630"
    />

    <!-- SECTION 2: Main calculator form -->
    <section id="calculator" class="scroll-mt-24 mt-4 p-8 bg-white rounded-2xl shadow-[0_2px_24px_rgba(26,26,24,0.06)] border border-forest-light max-w-md mx-auto" aria-label="Calorie calculator form">
      <form id="calorie-form" class="space-y-5">

        <!-- Metric / Imperial toggle -->
        <div class="flex gap-1 p-1 bg-forest-light rounded-full">
          <button type="button" id="unit-metric-btn" class="unit-toggle-btn flex-1 px-4 py-2 text-sm font-semibold rounded-full bg-forest text-cream transition-colors">Metric (Kg / Cm)</button>
          <button type="button" id="unit-imperial-btn" class="unit-toggle-btn flex-1 px-4 py-2 text-sm font-semibold rounded-full text-gray-soft transition-colors">Imperial (Lb / Ft)</button>
        </div>

        <!-- Biological Sex -->
        <div>
          <label class="block text-xs font-semibold tracking-wide text-gray-soft uppercase">Biological Sex</label>
          <div class="mt-2 flex gap-2">
            <button type="button" id="gender-male-btn" class="gender-btn flex-1 py-2.5 rounded-lg font-semibold text-sm bg-forest text-cream transition-colors">Male</button>
            <button type="button" id="gender-female-btn" class="gender-btn flex-1 py-2.5 rounded-lg font-semibold text-sm bg-forest-light text-charcoal transition-colors">Female</button>
          </div>
          <input type="hidden" id="gender" value="male" />
        </div>

        <!-- Age -->
        <div>
          <label for="age" class="block text-xs font-semibold tracking-wide text-gray-soft uppercase">Age</label>
          <div class="mt-1.5 relative">
            <input type="number" id="age" value="25" min="1" max="120" class="block w-full rounded-lg border-gray-200 bg-cream focus:border-forest focus:ring-forest pr-16" />
            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-sm text-gray-soft">years</span>
          </div>
        </div>

        <!-- Weight -->
        <div>
          <label for="weight" class="block text-xs font-semibold tracking-wide text-gray-soft uppercase">Weight</label>
          <div class="mt-1.5 relative">
            <input type="number" id="weight" value="70" min="1" class="block w-full rounded-lg border-gray-200 bg-cream focus:border-forest focus:ring-forest pr-12" />
            <span id="weight-unit-label" class="absolute right-4 top-1/2 -translate-y-1/2 text-sm text-gray-soft">kg</span>
          </div>
        </div>

        <!-- Height -->
        <div>
          <label class="block text-xs font-semibold tracking-wide text-gray-soft uppercase" id="height-label">Height</label>

          <div id="height-cm-input" class="mt-1.5 relative">
            <input type="number" id="height" value="170" min="1" class="block w-full rounded-lg border-gray-200 bg-cream focus:border-forest focus:ring-forest pr-12" />
            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-sm text-gray-soft">cm</span>
          </div>

          <div id="height-ftin-input" class="mt-1.5 hidden grid grid-cols-2 gap-2">
            <div class="relative">
              <input type="number" id="height-feet" min="0" value="5" class="block w-full rounded-lg border-gray-200 bg-cream focus:border-forest focus:ring-forest pr-10" />
              <span class="absolute right-3 top-1/2 -translate-y-1/2 text-sm text-gray-soft">ft</span>
            </div>
            <div class="relative">
              <input type="number" id="height-inches" min="0" max="11" value="7" class="block w-full rounded-lg border-gray-200 bg-cream focus:border-forest focus:ring-forest pr-10" />
              <span class="absolute right-3 top-1/2 -translate-y-1/2 text-sm text-gray-soft">in</span>
            </div>
          </div>
        </div>

        <!-- Activity Level -->
        <div>
          <label for="activity" class="block text-xs font-semibold tracking-wide text-gray-soft uppercase">Activity Level</label>
          <select id="activity" class="mt-1.5 block w-full rounded-lg border-gray-200 bg-cream focus:border-forest focus:ring-forest">
            <option value="1.2">Sedentary (little or no exercise)</option>
            <option value="1.375">Light (exercise 1-3 days/week)</option>
            <option value="1.55" selected>Moderate (exercise 3-5 days/week)</option>
            <option value="1.725">Active (exercise 6-7 days/week)</option>
            <option value="1.9">Very Active (hard exercise daily)</option>
          </select>
        </div>

        <button type="submit" class="w-full bg-forest text-cream font-body font-bold py-3.5 rounded-full hover:bg-forest-dark transition-colors">
          Calculate my calories
        </button>
      </form>

      <div id="result" class="mt-8 hidden">
        <div class="flex flex-col items-center">
          <div class="relative w-40 h-40">
            <svg class="w-full h-full -rotate-90" viewBox="0 0 100 100">
              <circle cx="50" cy="50" r="42" fill="none" stroke="#E8F0E9" stroke-width="8" />
              <circle
                id="gauge-circle"
                cx="50" cy="50" r="42" fill="none"
                stroke="#2F6B4F" stroke-width="8"
                stroke-linecap="round"
                stroke-dasharray="264"
                stroke-dashoffset="264"
                style="transition: stroke-dashoffset 1s ease-out;"
              />
            </svg>
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <span id="result-value" class="font-heading text-2xl font-bold text-forest">0</span>
              <span class="font-body text-xs text-gray-soft mt-1">calories/day</span>
            </div>
          </div>
          <p class="mt-2 font-body text-sm text-gray-soft">Maintenance calories per day</p>
        </div>

        <div class="mt-6 grid grid-cols-2 gap-3">
          <div class="bg-forest-light rounded-xl p-3 text-center">
            <p class="text-xs font-semibold text-gray-soft uppercase">Protein</p>
            <p id="protein-value" class="mt-1 font-heading text-lg font-bold text-charcoal">0 g</p>
          </div>
          <div class="bg-forest-light rounded-xl p-3 text-center">
            <p class="text-xs font-semibold text-gray-soft uppercase">Carbs</p>
            <p id="carbs-value" class="mt-1 font-heading text-lg font-bold text-charcoal">0 g</p>
          </div>
          <div class="bg-forest-light rounded-xl p-3 text-center">
            <p class="text-xs font-semibold text-gray-soft uppercase">Fat</p>
            <p id="fat-value" class="mt-1 font-heading text-lg font-bold text-charcoal">0 g</p>
          </div>
          <div class="bg-forest-light rounded-xl p-3 text-center">
            <p class="text-xs font-semibold text-gray-soft uppercase">BMI</p>
            <p id="bmi-value" class="mt-1 font-heading text-lg font-bold text-charcoal">0</p>
          </div>
        </div>
      </div>
    </section>
    <!-- END SECTION 2 -->

    <!-- SECTION 3: Weight Goal buttons (link to dedicated pages) -->
    <section class="mt-12 max-w-md mx-auto">
      <h2 class="font-heading text-2xl font-bold text-charcoal text-center">Set a Weight Goal</h2>
      <p class="mt-2 font-body text-gray-soft text-center">
        Tell us your current weight, target weight, and timeframe — we'll calculate exactly how many calories you should eat per day.
      </p>
      <div class="mt-5 flex gap-3">
        <a href="/weight-gain-calculator" class="flex-1 text-center bg-forest-light text-forest-dark font-body font-semibold py-3 rounded-full hover:bg-forest hover:text-cream transition-colors">
          Weight Gain Goal
        </a>
        <a href="/weight-loss-calculator" class="flex-1 text-center bg-forest text-cream font-body font-semibold py-3 rounded-full hover:bg-forest-dark transition-colors">
          Weight Loss Goal
        </a>
      </div>
    </section>
    <!-- END SECTION 3 -->
   

    <!-- SECTION 4: How it's calculated -->
    <section class="mt-12">
      <h2 class="font-heading text-2xl font-semibold text-forest">
        How is my calorie need calculated?
      </h2>
      <p class="mt-2 font-body text-charcoal/70">
        We use the Mifflin-St Jeor formula, one of the most accurate ways to estimate daily calorie needs based on your basal metabolic rate (BMR) and activity level.
      </p>
    </section>
    <!-- END SECTION 4 -->

    <!-- SECTION 5: FAQ (accordion style) -->
    <section class="mt-12">
      <h2 class="font-heading text-2xl font-semibold text-forest">Frequently Asked Questions</h2>

      <div class="mt-4 space-y-2" id="faq-accordion">
        <div class="border border-forest-light rounded-xl bg-white">
          <button type="button" class="faq-question w-full flex justify-between items-center text-left p-4 font-body font-medium text-charcoal">
            <span>How do I calculate my daily calories?</span>
            <span class="faq-icon text-forest transition-transform">&#9660;</span>
          </button>
          <div class="faq-answer hidden px-4 pb-4">
            <p class="font-body text-charcoal/70">
              First calculate your BMR (Basal Metabolic Rate) using your weight, height, age, and sex. Then multiply it by an activity factor to get your maintenance calories, also called TDEE. From there, subtract calories to lose weight or add calories to gain weight.
            </p>
          </div>
        </div>

        <div class="border border-forest-light rounded-xl bg-white">
          <button type="button" class="faq-question w-full flex justify-between items-center text-left p-4 font-body font-medium text-charcoal">
            <span>How many calories should I eat to lose weight?</span>
            <span class="faq-icon text-forest transition-transform">&#9660;</span>
          </button>
          <div class="faq-answer hidden px-4 pb-4">
            <p class="font-body text-charcoal/70">
              A daily deficit of 300 to 500 calories below your maintenance level is a safe, sustainable target for most people, typically resulting in 0.5 to 1 kg of weight loss per week.
            </p>
          </div>
        </div>

        <div class="border border-forest-light rounded-xl bg-white">
          <button type="button" class="faq-question w-full flex justify-between items-center text-left p-4 font-body font-medium text-charcoal">
            <span>How many calories should I eat to gain weight?</span>
            <span class="faq-icon text-forest transition-transform">&#9660;</span>
          </button>
          <div class="faq-answer hidden px-4 pb-4">
            <p class="font-body text-charcoal/70">
              Eating around 300 to 500 calories above your maintenance level per day supports steady, healthy weight gain without excessive fat gain.
            </p>
          </div>
        </div>

        <div class="border border-forest-light rounded-xl bg-white">
          <button type="button" class="faq-question w-full flex justify-between items-center text-left p-4 font-body font-medium text-charcoal">
            <span>What is BMR?</span>
            <span class="faq-icon text-forest transition-transform">&#9660;</span>
          </button>
          <div class="faq-answer hidden px-4 pb-4">
            <p class="font-body text-charcoal/70">
              BMR stands for Basal Metabolic Rate — the number of calories your body burns at rest just to keep basic functions like breathing and circulation running.
            </p>
          </div>
        </div>

        <div class="border border-forest-light rounded-xl bg-white">
          <button type="button" class="faq-question w-full flex justify-between items-center text-left p-4 font-body font-medium text-charcoal">
            <span>How many calories are in 1 kg of body fat?</span>
            <span class="faq-icon text-forest transition-transform">&#9660;</span>
          </button>
          <div class="faq-answer hidden px-4 pb-4">
            <p class="font-body text-charcoal/70">
              One kilogram of body fat holds roughly 7,700 calories. To lose 1 kg, you need to build up a total deficit of about that amount over time, not in a single day.
            </p>
          </div>
        </div>

        <div class="border border-forest-light rounded-xl bg-white">
          <button type="button" class="faq-question w-full flex justify-between items-center text-left p-4 font-body font-medium text-charcoal">
            <span>Is 1,200 calories a day too low?</span>
            <span class="faq-icon text-forest transition-transform">&#9660;</span>
          </button>
          <div class="faq-answer hidden px-4 pb-4">
            <p class="font-body text-charcoal/70">
              For most active adults, yes. 1,200 calories can be appropriate for some small-framed, sedentary women under medical guidance, but it's generally too low for men or active individuals and can lead to fatigue and nutrient shortfalls.
            </p>
          </div>
        </div>

        <div class="border border-forest-light rounded-xl bg-white">
          <button type="button" class="faq-question w-full flex justify-between items-center text-left p-4 font-body font-medium text-charcoal">
            <span>What is TDEE and how is it different from BMR?</span>
            <span class="faq-icon text-forest transition-transform">&#9660;</span>
          </button>
          <div class="faq-answer hidden px-4 pb-4">
            <p class="font-body text-charcoal/70">
              TDEE (Total Daily Energy Expenditure) is your BMR multiplied by an activity factor. BMR only covers calories burned at rest, while TDEE adds in exercise, daily movement, and digestion — it's your true maintenance calorie number.
            </p>
          </div>
        </div>

        <div class="border border-forest-light rounded-xl bg-white">
          <button type="button" class="faq-question w-full flex justify-between items-center text-left p-4 font-body font-medium text-charcoal">
            <span>How accurate is a calorie calculator?</span>
            <span class="faq-icon text-forest transition-transform">&#9660;</span>
          </button>
          <div class="faq-answer hidden px-4 pb-4">
            <p class="font-body text-charcoal/70">
              Formulas like Mifflin-St Jeor (used here) are typically accurate within about 10% for most people. They're a reliable starting point — track your actual weight trend over 2-3 weeks and adjust your calorie target up or down based on real results.
            </p>
          </div>
        </div>

        <div class="border border-forest-light rounded-xl bg-white">
          <button type="button" class="faq-question w-full flex justify-between items-center text-left p-4 font-body font-medium text-charcoal">
            <span>How much protein should I eat daily?</span>
            <span class="faq-icon text-forest transition-transform">&#9660;</span>
          </button>
          <div class="faq-answer hidden px-4 pb-4">
            <p class="font-body text-charcoal/70">
              A common range is 1.6 to 2.2 grams of protein per kg of body weight, especially if you're in a calorie deficit or trying to build muscle — this helps preserve lean mass and keeps you fuller for longer.
            </p>
          </div>
        </div>

        <div class="border border-forest-light rounded-xl bg-white">
          <button type="button" class="faq-question w-full flex justify-between items-center text-left p-4 font-body font-medium text-charcoal">
            <span>Why has my weight loss stalled even though I'm in a deficit?</span>
            <span class="faq-icon text-forest transition-transform">&#9660;</span>
          </button>
          <div class="faq-answer hidden px-4 pb-4">
            <p class="font-body text-charcoal/70">
              Plateaus are common and usually caused by your maintenance calories dropping as you lose weight, water retention hiding fat loss, or inconsistent tracking. Reassess your calories every few weeks as your weight changes, and look at weekly trends rather than daily fluctuations.
            </p>
          </div>
        </div>

        <div class="border border-forest-light rounded-xl bg-white">
          <button type="button" class="faq-question w-full flex justify-between items-center text-left p-4 font-body font-medium text-charcoal">
            <span>Does meal timing matter for weight loss or gain?</span>
            <span class="faq-icon text-forest transition-transform">&#9660;</span>
          </button>
          <div class="faq-answer hidden px-4 pb-4">
            <p class="font-body text-charcoal/70">
              Total daily calories matter far more than timing for most people. That said, spreading protein across 3-4 meals can help with muscle retention and appetite control, which indirectly supports consistency.
            </p>
          </div>
        </div>

        <div class="border border-forest-light rounded-xl bg-white">
          <button type="button" class="faq-question w-full flex justify-between items-center text-left p-4 font-body font-medium text-charcoal">
            <span>Can I have a cheat day while trying to lose weight?</span>
            <span class="faq-icon text-forest transition-transform">&#9660;</span>
          </button>
          <div class="faq-answer hidden px-4 pb-4">
            <p class="font-body text-charcoal/70">
              Yes — weight loss is driven by your average calorie balance over the week, not any single day. One higher-calorie day won't undo a deficit, as long as your overall weekly average stays on target.
            </p>
          </div>
        </div>

        <div class="border border-forest-light rounded-xl bg-white">
          <button type="button" class="faq-question w-full flex justify-between items-center text-left p-4 font-body font-medium text-charcoal">
            <span>How often should I update my calorie calculation?</span>
            <span class="faq-icon text-forest transition-transform">&#9660;</span>
          </button>
          <div class="faq-answer hidden px-4 pb-4">
            <p class="font-body text-charcoal/70">
              Recalculate every 4-5 kg of weight change, or roughly every 3-4 weeks. As your body weight changes, your BMR and maintenance calories change with it, so your target needs adjusting to keep progressing.
            </p>
          </div>
        </div>

        <div class="border border-forest-light rounded-xl bg-white">
          <button type="button" class="faq-question w-full flex justify-between items-center text-left p-4 font-body font-medium text-charcoal">
            <span>Does exercise change how many calories I should eat?</span>
            <span class="faq-icon text-forest transition-transform">&#9660;</span>
          </button>
          <div class="faq-answer hidden px-4 pb-4">
            <p class="font-body text-charcoal/70">
              Yes — your activity level directly affects your TDEE. Select the activity level that matches your typical week (including workouts) when using the calculator, so your calorie target already accounts for exercise.
            </p>
          </div>
        </div>

        <div class="border border-forest-light rounded-xl bg-white">
          <button type="button" class="faq-question w-full flex justify-between items-center text-left p-4 font-body font-medium text-charcoal">
            <span>Is it normal for weight to fluctuate day to day?</span>
            <span class="faq-icon text-forest transition-transform">&#9660;</span>
          </button>
          <div class="faq-answer hidden px-4 pb-4">
            <p class="font-body text-charcoal/70">
              Completely normal. Daily weight can swing 1-2 kg from water, sodium intake, hormones, and digestion. Focus on the weekly average trend in the Track Progress page rather than any single day's number.
            </p>
          </div>
        </div>
      </div>
    </section>
    <!-- END SECTION 5 -->

  </main>
</Layout>

<!-- SECTION 5B: WebApplication structured data (JSON-LD) - tells Google this is a functional tool -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "CalorieAce",
  "url": "https://calorieace.com",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "Any (Web-based)",
  "description": "Free calorie calculator to find your daily calorie needs, TDEE, BMI, and macros for weight loss or weight gain.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "Daily calorie calculator (BMR & TDEE)",
    "BMI calculator",
    "Macro breakdown (protein, carbs, fat)",
    "Weight loss calorie deficit planner",
    "Weight gain calorie surplus planner",
    "Progress tracking"
  ]
})}>
</script>

