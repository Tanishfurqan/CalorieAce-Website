      "name": "Is it normal for weight to fluctuate day to day?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, daily weight can swing 1-2 kg from water, sodium, hormones, and digestion. Focus on the weekly average trend rather than any single day."
      }
    }
  ]
})}>
</script>
