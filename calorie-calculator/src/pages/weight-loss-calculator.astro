<!-- SCRIPT 2: CALCULATOR LOGIC (units, gender, BMR/TDEE, submit + auto-scroll) -->
<script>
  let currentUnitSystem: 'metric' | 'imperial' = 'metric';
 
  const form = document.getElementById('calorie-form') as HTMLFormElement;
  const resultBox = document.getElementById('result') as HTMLDivElement;
  const resultValue = document.getElementById('result-value') as HTMLSpanElement;
  const maintenanceValue = document.getElementById('maintenance-value') as HTMLSpanElement;
 
  const metricBtn = document.getElementById('unit-metric-btn') as HTMLButtonElement;
  const imperialBtn = document.getElementById('unit-imperial-btn') as HTMLButtonElement;
  const weightUnitLabel = document.getElementById('weight-unit-label') as HTMLSpanElement;
  const heightLabel = document.getElementById('height-label') as HTMLLabelElement;
  const heightCmInput = document.getElementById('height-cm-input') as HTMLDivElement;
  const heightFtinInput = document.getElementById('height-ftin-input') as HTMLDivElement;
  const weightInput = document.getElementById('weight') as HTMLInputElement;
  const roadmapCta = document.getElementById('roadmap-cta') as HTMLDivElement;
 
  // --- Unit toggle (Metric / Imperial) ---
  function setUnitSystem(system: 'metric' | 'imperial') {
    currentUnitSystem = system;
 
    if (system === 'metric') {
      metricBtn.classList.add('bg-forest', 'text-cream');
      metricBtn.classList.remove('text-gray-soft');
      imperialBtn.classList.remove('bg-forest', 'text-cream');
      imperialBtn.classList.add('text-gray-soft');
 
      weightUnitLabel.textContent = 'kg';
      heightLabel.textContent = 'Height (cm)';
      heightCmInput.classList.remove('hidden');
      heightFtinInput.classList.add('hidden');
      weightInput.value = '70';
    } else {
      imperialBtn.classList.add('bg-forest', 'text-cream');
      imperialBtn.classList.remove('text-gray-soft');
      metricBtn.classList.remove('bg-forest', 'text-cream');
      metricBtn.classList.add('text-gray-soft');
 
      weightUnitLabel.textContent = 'lb';
      heightLabel.textContent = 'Height';
      heightCmInput.classList.add('hidden');
      heightFtinInput.classList.remove('hidden');
      weightInput.value = '154';
    }
  }
 
  metricBtn.addEventListener('click', () => setUnitSystem('metric'));
  imperialBtn.addEventListener('click', () => setUnitSystem('imperial'));
 
  // --- Gender toggle ---
  const genderBtns = document.querySelectorAll('.gender-btn') as NodeListOf<HTMLButtonElement>;
  const genderInput = document.getElementById('gender') as HTMLInputElement;
 
  function selectGender(clicked: HTMLButtonElement, value: string) {
    genderBtns.forEach((b) => {
      b.classList.remove('bg-forest', 'text-cream');
      b.classList.add('bg-forest-light', 'text-charcoal');
    });
    clicked.classList.add('bg-forest', 'text-cream');
    clicked.classList.remove('bg-forest-light', 'text-charcoal');
    genderInput.value = value;
  }
 
  document.getElementById('gender-male-btn')?.addEventListener('click', (e) =>
    selectGender(e.currentTarget as HTMLButtonElement, 'male'));
  document.getElementById('gender-female-btn')?.addEventListener('click', (e) =>
    selectGender(e.currentTarget as HTMLButtonElement, 'female'));
 
  // --- Form submit: calculate BMR/TDEE, show result, auto-scroll, store state for roadmap ---
  form.addEventListener('submit', (e) => {
    e.preventDefault();
 
    const gender = genderInput.value;
    const age = Number((document.getElementById('age') as HTMLInputElement).value);
    const activity = Number((document.getElementById('activity') as HTMLSelectElement).value);
    const deficit = Number((document.getElementById('deficit') as HTMLSelectElement).value);
    const rawWeight = Number(weightInput.value);
 
    const weightKg = currentUnitSystem === 'imperial' ? rawWeight / 2.20462 : rawWeight;
 
    let heightCm: number;
    if (currentUnitSystem === 'imperial') {
      const feet = Number((document.getElementById('height-feet') as HTMLInputElement).value);
      const inches = Number((document.getElementById('height-inches') as HTMLInputElement).value);
      heightCm = (feet * 12 + inches) * 2.54;
    } else {
      heightCm = Number((document.getElementById('height') as HTMLInputElement).value);
    }
 
    let bmr;
    if (gender === 'male') {
      bmr = 10 * weightKg + 6.25 * heightCm - 5 * age + 5;
    } else {
      bmr = 10 * weightKg + 6.25 * heightCm - 5 * age - 161;
    }
 
    const maintenance = Math.round(bmr * activity);
    const targetCalories = maintenance - deficit;
 
    resultValue.textContent = targetCalories.toString();
    maintenanceValue.textContent = maintenance.toString();
    resultBox.classList.remove('hidden');
 
    // Auto-scroll so the result is centered in view (mobile + desktop)
    resultBox.scrollIntoView({ behavior: 'smooth', block: 'center' });

    // Animate the gauge ring (same pattern as the homepage calculator)
    const gaugeCircle = document.getElementById('gauge-circle') as unknown as SVGCircleElement;
    const circumference = 264;
    const gaugePercentage = Math.min(targetCalories / 4000, 1);
    const gaugeOffset = circumference - (gaugePercentage * circumference);
    setTimeout(() => {
      gaugeCircle.style.strokeDashoffset = gaugeOffset.toString();
    }, 50);
 
    // Store this calculation so the Roadmap script (below) can reuse it
    const rateKgPerWeek = deficit / 1000; // 250/500/750/1000 -> 0.25/0.5/0.75/1
 
    (window as any).__loseCalcState = {
      gender, age, activity, weightKg, heightCm,
      maintenance, targetCalories, rateKgPerWeek, currentUnitSystem,
    };
 
    roadmapCta.classList.remove('hidden');
    document.getElementById('roadmap-intake')?.classList.add('hidden');
    document.getElementById('roadmap-panel')?.classList.add('hidden');
  });
</script>
 
<!-- SCRIPT 3: ROADMAP LOGIC (intake, milestone + meal-plan generation, localStorage) -->
<script>
  import mealsData from '../data/meals.json';
 
  type MealItem = { name: string; calories: number; protein: number; region: 'asian' | 'western' | 'both' };
 
  const roadmapCta = document.getElementById('roadmap-cta') as HTMLDivElement;
  const roadmapCtaBtn = document.getElementById('roadmap-cta-btn') as HTMLButtonElement;
  const roadmapIntake = document.getElementById('roadmap-intake') as HTMLDivElement;
  const roadmapGenerateBtn = document.getElementById('roadmap-generate-btn') as HTMLButtonElement;
  const roadmapPanel = document.getElementById('roadmap-panel') as HTMLDivElement;
  const roadmapBackBtn = document.getElementById('roadmap-back-btn') as HTMLButtonElement;
  const dietPreference = document.getElementById('diet-preference') as HTMLInputElement;
  const mealRegion = document.getElementById('meal-region') as HTMLInputElement;
  const mealsPerDay = document.getElementById('meals-per-day') as HTMLInputElement;
 
  const roadmapTargetWeight = document.getElementById('roadmap-target-weight') as HTMLInputElement;
  const roadmapTimeframe = document.getElementById('roadmap-timeframe') as HTMLInputElement;
  const roadmapTimeframeWarning = document.getElementById('roadmap-timeframe-warning') as HTMLParagraphElement;
  const roadmapTargetWeightUnitLabel = document.getElementById('roadmap-target-weight-unit-label') as HTMLSpanElement;
  const roadmapTargetWeightError = document.getElementById('roadmap-target-weight-error') as HTMLParagraphElement;
  const roadmapTargetWeightDanger = document.getElementById('roadmap-target-weight-danger') as HTMLParagraphElement;

  const dietBtns = document.querySelectorAll('.diet-btn') as NodeListOf<HTMLButtonElement>;
  const regionBtns = document.querySelectorAll('.region-btn') as NodeListOf<HTMLButtonElement>;
  const mealsBtns = document.querySelectorAll('.meals-btn') as NodeListOf<HTMLButtonElement>;
 
  // --- Shared button-picker helper (diet + region + meals) ---
  function selectButton(btns: NodeListOf<HTMLButtonElement>, clicked: HTMLButtonElement, hiddenInput: HTMLInputElement, value: string) {
    btns.forEach((b) => {
      b.classList.remove('bg-forest', 'text-cream');
      b.classList.add('bg-forest-light', 'text-charcoal');
    });
    clicked.classList.add('bg-forest', 'text-cream');
    clicked.classList.remove('bg-forest-light', 'text-charcoal');
    hiddenInput.value = value;
  }
 
  document.getElementById('diet-veg-btn')?.addEventListener('click', (e) =>
    selectButton(dietBtns, e.currentTarget as HTMLButtonElement, dietPreference, 'veg'));
  document.getElementById('diet-nonveg-btn')?.addEventListener('click', (e) =>
    selectButton(dietBtns, e.currentTarget as HTMLButtonElement, dietPreference, 'non-veg'));

  document.getElementById('region-asian-btn')?.addEventListener('click', (e) =>
    selectButton(regionBtns, e.currentTarget as HTMLButtonElement, mealRegion, 'asian'));
  document.getElementById('region-western-btn')?.addEventListener('click', (e) =>
    selectButton(regionBtns, e.currentTarget as HTMLButtonElement, mealRegion, 'western'));
 
  document.getElementById('meals-3-btn')?.addEventListener('click', (e) =>
    selectButton(mealsBtns, e.currentTarget as HTMLButtonElement, mealsPerDay, '3'));
  document.getElementById('meals-4-btn')?.addEventListener('click', (e) =>
    selectButton(mealsBtns, e.currentTarget as HTMLButtonElement, mealsPerDay, '4'));
  document.getElementById('meals-5-btn')?.addEventListener('click', (e) =>
    selectButton(mealsBtns, e.currentTarget as HTMLButtonElement, mealsPerDay, '5'));
 
  const rmCurrent = document.getElementById('rm-current') as HTMLParagraphElement;
  const rmTarget = document.getElementById('rm-target') as HTMLParagraphElement;
  const rmTotal = document.getElementById('rm-total') as HTMLParagraphElement;
  const rmTimeframe = document.getElementById('rm-timeframe') as HTMLParagraphElement;
  const rmWarning = document.getElementById('rm-warning') as HTMLParagraphElement;
  const rmCalories = document.getElementById('rm-calories') as HTMLParagraphElement;
  const rmProtein = document.getElementById('rm-protein') as HTMLParagraphElement;
  const rmMilestones = document.getElementById('rm-milestones') as HTMLUListElement;
  const rmMealplan = document.getElementById('rm-mealplan') as HTMLDivElement;
 
  const STORAGE_KEY = 'weightGoalPlanner';
 
  function loadPlanner(): any {
    const raw = localStorage.getItem(STORAGE_KEY);
    return raw ? JSON.parse(raw) : null;
  }
 
  function savePlanner(data: any) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
  }
 
  // --- Meal plan generation: greedy fit to per-meal calorie/protein target ---
  function pickMeal(pool: MealItem[], calorieTarget: number, proteinTarget: number): MealItem[] {
    const shuffled = [...pool].sort(() => Math.random() - 0.5);
    const picked: MealItem[] = [];
    let cals = 0, protein = 0;
 
    for (const item of shuffled) {
      if (cals + item.calories <= calorieTarget * 1.15) {
        picked.push(item);
        cals += item.calories;
        protein += item.protein;
        if (cals >= calorieTarget * 0.85 && protein >= proteinTarget * 0.7) break;
      }
    }
    return picked.length ? picked : [shuffled[0]];
  }
 
  function buildMealPlan(dailyCalories: number, dailyProtein: number, meals: number, diet: 'veg' | 'non-veg', region: 'asian' | 'western') {
    const fullPool: MealItem[] = (mealsData as any)[diet];
    const pool = fullPool.filter((item) => item.region === region || item.region === 'both');
    const perMealCalories = dailyCalories / meals;
    const perMealProtein = dailyProtein / meals;
    const plan = [];
    for (let i = 0; i < meals; i++) {
      plan.push(pickMeal(pool, perMealCalories, perMealProtein));
    }
    return plan;
  }
 
  // --- Milestones: dynamic quartile split between current and target weight ---
  function buildMilestones(currentWeight: number, targetWeight: number): number[] {
    const steps = 4;
    const diff = targetWeight - currentWeight;
    const milestones = [];
    for (let i = 1; i <= steps; i++) {
      milestones.push(Math.round((currentWeight + (diff * i) / steps) * 10) / 10);
    }
    return milestones;
  }
 
  // --- Open intake step ---
  roadmapCtaBtn.addEventListener('click', () => {
    const state = (window as any).__loseCalcState;
    roadmapTargetWeightUnitLabel.textContent = state?.currentUnitSystem === 'imperial' ? 'lb' : 'kg';
    roadmapTargetWeightError.classList.add('hidden');
    roadmapTargetWeightDanger.classList.add('hidden');
    roadmapTimeframeWarning.classList.add('hidden');
    roadmapTimeframe.value = '';
    roadmapCta.classList.add('hidden');
    roadmapIntake.classList.remove('hidden');
    roadmapIntake.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
 
  // --- Generate roadmap ---
  // Mobile fix: blur any focused input first so an on-screen keyboard closing
  // doesn't swallow the tap before the click handler runs.
  function generateRoadmap() {
    const state = (window as any).__loseCalcState;
    if (!state) return;
 
    const rawTargetWeight = Number(roadmapTargetWeight.value);
    const targetWeightKg = state.currentUnitSystem === 'imperial' ? rawTargetWeight / 2.20462 : rawTargetWeight;
 
    if (!rawTargetWeight || targetWeightKg >= state.weightKg) {
      roadmapTargetWeightError.classList.remove('hidden');
      roadmapTargetWeightDanger.classList.add('hidden');
      return;
    }
    roadmapTargetWeightError.classList.add('hidden');

    // Safety check: block medically implausible targets (e.g. a BMI too low to be survivable)
    // instead of generating an "aggressive plan" — matches the spec's own Safety requirement.
    const heightM = state.heightCm / 100;
    const targetBmi = targetWeightKg / (heightM * heightM);

    if (targetBmi < 16) {
      roadmapTargetWeightDanger.classList.remove('hidden');
      return;
    }
    roadmapTargetWeightDanger.classList.add('hidden');

    const diet = dietPreference.value as 'veg' | 'non-veg';
    const region = mealRegion.value as 'asian' | 'western';
    const meals = Number(mealsPerDay.value);
 
    const currentWeight = Math.round(state.weightKg * 10) / 10;
    const targetWeight = Math.round(targetWeightKg * 10) / 10;
    const totalToLose = Math.round((currentWeight - targetWeight) * 10) / 10;
    const dailyProtein = Math.round(state.weightKg * 1.8); // ~1.8g/kg for a deficit phase

    // --- Timeframe: user-entered weeks (optional) overrides the deficit-based pace ---
    const CALORIES_PER_KG = 7700;
    const MAX_SAFE_DAILY_ADJUSTMENT = 1000;
    const enteredWeeks = Number(roadmapTimeframe.value);

    let weeks: number;
    let dailyCalories: number;
    let warningMessage = '';

    if (enteredWeeks > 0) {
      weeks = enteredWeeks;
      const totalCaloriesNeeded = totalToLose * CALORIES_PER_KG;
      const requestedDailyDeficit = Math.round(totalCaloriesNeeded / (weeks * 7));
      const dailyDeficit = Math.min(requestedDailyDeficit, MAX_SAFE_DAILY_ADJUSTMENT);
      dailyCalories = state.maintenance - dailyDeficit;

      if (requestedDailyDeficit > MAX_SAFE_DAILY_ADJUSTMENT) {
        const realisticWeeks = Math.ceil(totalCaloriesNeeded / (MAX_SAFE_DAILY_ADJUSTMENT * 7));
        warningMessage = `Your timeframe was too short for a safe pace, so we've stretched it to a realistic, safe schedule.`;
        weeks = realisticWeeks; // show the real, safe timeframe — not the unrealistic input
      }

      const minSafe = state.gender === 'male' ? 1500 : 1200;
      if (dailyCalories < minSafe) {
        warningMessage += ` This is also below the generally recommended minimum of ${minSafe} calories/day.`;
      }
    } else {
      weeks = Math.max(1, Math.round(totalToLose / state.rateKgPerWeek));
      dailyCalories = state.targetCalories;
    }

    if (warningMessage) {
      roadmapTimeframeWarning.textContent = warningMessage.trim();
      roadmapTimeframeWarning.classList.remove('hidden');
    } else {
      roadmapTimeframeWarning.classList.add('hidden');
    }
 
    const milestones = buildMilestones(currentWeight, targetWeight);
    const mealPlan = buildMealPlan(dailyCalories, dailyProtein, meals, diet, region);
 
    const roadmapData = {
      goal: 'lose',
      profile: { gender: state.gender, age: state.age, activity: state.activity, currentWeight },
      target: { targetWeight, totalToLose, weeks, dailyCalories, dailyProtein, diet, meals },
      milestones,
      mealPlan,
      warningMessage,
      weightHistory: [{ date: new Date().toISOString().split('T')[0], weight: currentWeight }],
    };
 
    savePlanner(roadmapData);
    renderRoadmap(roadmapData);
 
    roadmapIntake.classList.add('hidden');
    roadmapPanel.classList.remove('hidden');
    roadmapPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
 
  roadmapGenerateBtn.addEventListener('click', () => {
    if (document.activeElement instanceof HTMLElement) {
      document.activeElement.blur();
    }
    generateRoadmap();
  });
 
  // --- Render roadmap result ---
  function renderRoadmap(data: any) {
    rmCurrent.textContent = `${data.profile.currentWeight} kg`;
    rmTarget.textContent = `${data.target.targetWeight} kg`;
    rmTotal.textContent = `${data.target.totalToLose} kg`;
    rmTimeframe.textContent = `~${data.target.weeks} weeks`;
    if (data.warningMessage) {
      rmWarning.textContent = data.warningMessage;
      rmWarning.classList.remove('hidden');
    } else {
      rmWarning.classList.add('hidden');
    }
    rmCalories.textContent = `${data.target.dailyCalories} cal`;
    rmProtein.textContent = `${data.target.dailyProtein} g`;
 
    rmMilestones.innerHTML = '';
    let prev = data.profile.currentWeight;
    data.milestones.forEach((m: number) => {
      const li = document.createElement('li');
      li.textContent = `${prev} kg → ${m} kg`;
      rmMilestones.appendChild(li);
      prev = m;
    });
 
    rmMealplan.innerHTML = '';
    data.mealPlan?.forEach((meal: any[], i: number) => {
      const div = document.createElement('div');
      const totalCal = meal.reduce((s, m) => s + m.calories, 0);
      const totalProtein = meal.reduce((s, m) => s + m.protein, 0);
      div.innerHTML = `<p class="font-semibold text-charcoal">Meal ${i + 1} (~${totalCal} cal, ${totalProtein}g protein)</p>
        <ul class="list-disc list-inside text-charcoal/70">${meal.map((f) => `<li>${f.name}</li>`).join('')}</ul>`;
      rmMealplan.appendChild(div);
    });
  }
 
  roadmapBackBtn.addEventListener('click', () => {
    roadmapPanel.classList.add('hidden');
    roadmapCta.classList.remove('hidden');
  });
</script>
 
<!-- SCRIPT 4: FAQ ACCORDION UI -->
<script>
  const faqButtons = document.querySelectorAll('.faq-question');
 
  faqButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const answer = button.nextElementSibling as HTMLDivElement;
      const icon = button.querySelector('.faq-icon') as HTMLSpanElement;
 
      const isHidden = answer.classList.contains('hidden');
 
      document.querySelectorAll('.faq-answer').forEach((el) => el.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach((el) => el.classList.remove('rotate-180'));
 
      if (isHidden) {
        answer.classList.remove('hidden');
        icon.classList.add('rotate-180');
      }
    });
  });
</script>