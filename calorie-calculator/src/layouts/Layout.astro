---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image = '/og-default.jpg', noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-R0K18RDYWS"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-R0K18RDYWS');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph tags (for WhatsApp, Facebook, LinkedIn previews) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL(image, Astro.site)} />

    <!-- Twitter Card tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="font-body bg-cream text-charcoal">
    <nav class="bg-cream border-b border-forest-light relative sticky top-0 z-50">
      <div class="max-w-5xl mx-auto px-6 py-5 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <img src="/logoo.webp" alt="CalorieAce logo" class="w-8 h-8" width="32" height="32" />
          <span class="font-heading text-lg font-bold text-charcoal">CalorieAce</span>
        </a>

        <!-- Desktop links -->
        <div class="hidden md:flex items-center gap-8">
          <a href="/" class="font-body text-sm font-medium text-gray-soft hover:text-forest transition-colors">Home</a>
          <a href="/weight-loss-calculator" class="font-body text-sm font-medium text-gray-soft hover:text-forest transition-colors">Weight Loss</a>
          <a href="/weight-gain-calculator" class="font-body text-sm font-medium text-gray-soft hover:text-forest transition-colors">Weight Gain</a>
          <a href="/guides" class="font-body text-sm font-medium text-gray-soft hover:text-forest transition-colors">Guides</a>
          <a href="/progress" id="nav-progress-link" class="font-body text-sm font-semibold text-forest hover:text-forest-dark transition-colors">My Progress</a>
        </div>

        <!-- Mobile hamburger button -->
        <button id="mobile-menu-btn" class="md:hidden text-charcoal p-2" aria-label="Toggle menu">
          <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Mobile dropdown menu -->
      <div id="mobile-menu" class="hidden md:hidden flex-col bg-cream border-t border-forest-light px-6 py-4 space-y-3">
        <a href="/" class="block font-body text-sm font-medium text-gray-soft hover:text-forest transition-colors">Home</a>
        <a href="/#calculator" class="block font-body text-sm font-medium text-gray-soft hover:text-forest transition-colors">Calorie Calculator</a>
        <a href="/weight-loss-calculator" class="block font-body text-sm font-medium text-gray-soft hover:text-forest transition-colors">Weight Loss</a>
        <a href="/weight-gain-calculator" class="block font-body text-sm font-medium text-gray-soft hover:text-forest transition-colors">Weight Gain</a>
        <a href="/guides" class="block font-body text-sm font-medium text-gray-soft hover:text-forest transition-colors">Guides</a>
        <a href="/progress" id="nav-progress-link-mobile" class="block font-body text-sm font-semibold text-forest hover:text-forest-dark transition-colors">My Progress</a>
      </div>
    </nav>

    <slot />

    <footer class="mt-20 bg-forest-light border-t border-forest-light">
      <div class="max-w-5xl mx-auto px-6 py-10">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-8">
          <div class="col-span-2 sm:col-span-1">
            <a href="/" class="flex items-center gap-2">
              <img src="/logoo.webp" alt="CalorieAce logo" class="w-8 h-8" width="32" height="32" />
              <span class="font-heading text-lg font-bold text-charcoal">CalorieAce</span>
            </a>
            <p class="mt-3 font-body text-sm text-charcoal/60">
              Free calorie, macro, and weight goal calculators to help you eat smarter.
            </p>
          </div>

          <div>
            <h3 class="font-heading text-sm font-semibold text-charcoal uppercase tracking-wide">Guides</h3>
<ul class="mt-3 space-y-2">
  <li><a href="/guides" class="font-body text-sm text-charcoal/70 hover:text-forest transition-colors">All Guides</a></li>
  <li><a href="/blog/how-many-calories-per-day" class="font-body text-sm text-charcoal/70 hover:text-forest transition-colors">How Many Calories Per Day</a></li>
  <li><a href="/blog/what-is-bmr" class="font-body text-sm text-charcoal/70 hover:text-forest transition-colors">What Is BMR</a></li>
</ul>
          </div>

          

          <div>
            <h3 class="font-heading text-sm font-semibold text-charcoal uppercase tracking-wide">Company</h3>
            <ul class="mt-3 space-y-2">
              <li><a href="/about-us" class="font-body text-sm text-charcoal/70 hover:text-forest transition-colors">About Us</a></li>
              <li><a href="/contact-us" class="font-body text-sm text-charcoal/70 hover:text-forest transition-colors">Contact Us</a></li>
              <li><a href="/privacy-policy" class="font-body text-sm text-charcoal/70 hover:text-forest transition-colors">Privacy Policy</a></li>
              <li><a href="/terms-and-conditions" class="font-body text-sm text-charcoal/70 hover:text-forest transition-colors">Terms & Conditions</a></li>
            </ul>
          </div>
        </div>

        <div class="mt-10 pt-6 border-t border-forest/10 text-center">
          <p class="font-body text-sm text-charcoal/50">
            &copy; 2026 CalorieAce. All rights reserved.
          </p>
        </div>
      </div>
    </footer>
  <script>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const hamburgerIcon = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');

      function closeMenu() {
        mobileMenu?.classList.add('hidden');
        mobileMenu?.classList.remove('flex');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      }

      menuBtn?.addEventListener('click', () => {
        const isHidden = mobileMenu?.classList.contains('hidden');
        if (isHidden) {
          mobileMenu?.classList.remove('hidden');
          mobileMenu?.classList.add('flex');
          hamburgerIcon?.classList.add('hidden');
          closeIcon?.classList.remove('hidden');
        } else {
          closeMenu();
        }
      });

      const mobileMenuLinks = mobileMenu?.querySelectorAll('a');
      mobileMenuLinks?.forEach((link) => {
        link.addEventListener('click', closeMenu);
      });

    </script>
  </body>
</html>